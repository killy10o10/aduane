# ---- Database (Supabase Postgres) ----
# Pooled connection (app runtime). Use the Supabase "Transaction" pooler URL (port 6543).
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (migrations only). Supabase "Session" pooler or direct (port 5432).
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---- Supabase Auth / client ----
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"
# Server-only. Never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- AI (v3, server-only — not used in v1) ----
# ANTHROPIC_API_KEY="<server-held-key-never-shipped-to-client>"
